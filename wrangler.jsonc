{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expense-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // UI is served by the same Worker (Workers Static Assets), so /chat and /api
  // are same-origin and need no CORS. See docs/DECISIONS.md (D8).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/chat", "/mcp"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "expense_agent",
      // Replace with the id printed by `npx wrangler d1 create expense_agent`.
      // Local dev (`wrangler dev`) works with this placeholder.
      "database_id": "b79763b0-7866-4d93-8cee-2b51abad9594",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TIMEZONE": "Africa/Cairo",
    "LLM_PROVIDER": "groq",
    "LLM_MODEL": "openai/gpt-oss-120b",
    // Used for the rest of a request when the main model's free quota is used up (429).
    "LLM_FALLBACK_MODEL": "llama-3.1-8b-instant",
    // "off" sends every message to the LLM (the eval baseline).
    "FAST_PATH": "on",
    "LARGE_AMOUNT_THRESHOLD": "5000",
    "OLD_DATE_CONFIRM_DAYS": "60",
    // Cloudflare Access (docs/SECURITY.md). Fill both to require an Access JWT.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Rate limits per account. 0 disables a limit.
    "CHAT_RATE_PER_MIN": "20",
    "CHAT_RATE_PER_DAY": "200",
    "API_RATE_PER_MIN": "300",
    // Messages per day, across ALL accounts, that may use the LLM (the shared free Groq quota).
    "LLM_RATE_PER_DAY": "800",
    // "off" closes sign-ups for new accounts (existing ones keep working).
    "SIGNUP_OPEN": "on",
    // Voice input: Groq Whisper (free: 2,000 clips a day). Clips per day for all accounts together.
    "STT_MODEL": "whisper-large-v3-turbo",
    "VOICE_RATE_PER_DAY": "1500"
  },
  "observability": { "enabled": true }
  // Secret (never in this file): LLM_API_KEY
  //   npx wrangler secret put LLM_API_KEY
  // For local dev put them in .dev.vars (gitignored).
}
