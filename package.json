{
  "name": "expense-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Natural-language personal expense tracker on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply expense_agent --local",
    "db:migrate:remote": "wrangler d1 migrations apply expense_agent --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "vendor:chart": "node -e \"require('fs').copyFileSync('node_modules/chart.js/dist/chart.umd.min.js','public/vendor/chart.umd.min.js')\"",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "db:seed-personal:local": "node scripts/build-personal-sql.mjs && wrangler d1 execute expense_agent --local --file=.wrangler/personal_seed.sql",
    "db:seed-personal:remote": "node scripts/build-personal-sql.mjs && wrangler d1 execute expense_agent --remote --file=.wrangler/personal_seed.sql",
    "eval": "node scripts/eval.mjs",
    "mcp:client": "node scripts/mcp-client.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261019.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "chart.js": "4.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.151.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "workerd@1.20261001.1": true
  }
}
